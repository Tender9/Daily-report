# 运行环境: development | production | test
APP_ENV=development

# 服务监听地址与端口
HOST=127.0.0.1
PORT=2001
CORS_ORIGINS=http://localhost:1001

# 最大上传文件限制 (MB)
MAX_UPLOAD_SIZE_MB=20

# 数据库与自动备份配置
# DB_PATH=tasks.db
AUTO_BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7

# AI 引擎模式开关: cloud (云端 API) | local (本地 GGUF 模型)
AI_PROVIDER=cloud

# 火山引擎 (Volcengine Ark) 云端 API 配置
CLOUD_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
CLOUD_API_KEY=your_volcengine_api_key_here
CLOUD_MODEL=your_endpoint_or_model_id

# 本地 GGUF 模型加载配置 (相对项目根路径或绝对路径)
MODEL_MODE=local_gguf
MODEL_PATH=models/MiniCPM-V-4_6-Thinking-Q4_K_M.gguf
MMPROJ_PATH=models/mmproj-model-f16.gguf
N_CTX=4096
N_GPU_LAYERS=-1
